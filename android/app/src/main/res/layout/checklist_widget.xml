<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="10dp">
    <LinearLayout
        android:id="@+id/list_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/list_sparky"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />
        <TextView
            android:id="@+id/list_heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:textColor="#F0F3EB"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/list_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textColor="#B6E9BD"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/list_row_0"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/widget_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:visibility="gone">
        <ImageView
            android:id="@+id/list_check_0"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_check_open" />
        <TextView
            android:id="@+id/list_title_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#F0F3EB"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/list_hint_0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8FA197"
            android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/list_row_1"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/widget_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:visibility="gone">
        <ImageView
            android:id="@+id/list_check_1"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_check_open" />
        <TextView
            android:id="@+id/list_title_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#F0F3EB"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/list_hint_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8FA197"
            android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/list_row_2"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/widget_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:visibility="gone">
        <ImageView
            android:id="@+id/list_check_2"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_check_open" />
        <TextView
            android:id="@+id/list_title_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#F0F3EB"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/list_hint_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8FA197"
            android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/list_row_3"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/widget_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:visibility="gone">
        <ImageView
            android:id="@+id/list_check_3"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_check_open" />
        <TextView
            android:id="@+id/list_title_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#F0F3EB"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/list_hint_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8FA197"
            android:textSize="11sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/list_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="#8FA197"
        android:textSize="12sp" />
</LinearLayout>
